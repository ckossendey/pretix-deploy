# Variables of the Railway service "pretix" (names only, values live in Railway).
# ${{Postgres.*}} / ${{Redis.*}} are Railway references to the database services.

PORT=80
PRETIX_PRETIX_INSTANCE_NAME=S+K Tickets
PRETIX_PRETIX_URL=https://tickets.skverlag.de
PRETIX_PRETIX_CURRENCY=EUR
PRETIX_PRETIX_TRUST_X_FORWARDED_FOR=true
PRETIX_PRETIX_TRUST_X_FORWARDED_PROTO=true
PRETIX_PRETIX_OBLIGATORY_2FA=true
PRETIX_DJANGO_SECRET=                      # openssl rand -hex 50

PRETIX_DATABASE_BACKEND=postgresql
PRETIX_DATABASE_NAME=${{Postgres.PGDATABASE}}
PRETIX_DATABASE_USER=${{Postgres.PGUSER}}
PRETIX_DATABASE_PASSWORD=${{Postgres.PGPASSWORD}}
PRETIX_DATABASE_HOST=${{Postgres.PGHOST}}
PRETIX_DATABASE_PORT=${{Postgres.PGPORT}}

PRETIX_REDIS_LOCATION=${{Redis.REDIS_URL}}/0
PRETIX_REDIS_SESSIONS=true
PRETIX_CELERY_BROKER=${{Redis.REDIS_URL}}/1
PRETIX_CELERY_BACKEND=${{Redis.REDIS_URL}}/2

PRETIX_MAIL_HOST=in-v3.mailjet.com
PRETIX_MAIL_PORT=587
PRETIX_MAIL_TLS=true
PRETIX_MAIL_USER=                          # Mailjet API key
PRETIX_MAIL_PASSWORD=                      # Mailjet secret key
PRETIX_MAIL_FROM=kundenservice@skverlag.de

# Only for the first start: replaces pretix's default admin (admin@localhost / admin).
# Remove PRETIX_ADMIN_PASSWORD afterwards.
PRETIX_ADMIN_EMAIL=
PRETIX_ADMIN_PASSWORD=                     # at least 12 characters
